{
  "name": "react-lab-features",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -n api,web,feed -c cyan,green,yellow \"pnpm --filter @diary/api dev\" \"pnpm --filter @diary/web dev\" \"pnpm --filter @diary/feed dev\"",
    "dev:api": "pnpm --filter @diary/api dev",
    "dev:web": "pnpm --filter @diary/web dev",
    "dev:feed": "pnpm --filter @diary/feed dev",
    "build": "pnpm -r build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
