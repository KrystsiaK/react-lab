    "@nestjs/platform-express": "^11.1.8",
    "@prisma/client": "^6.3.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
